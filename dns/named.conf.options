acl lan { 127.0.0.0/8; 192.168.10.0/24; };

options {
    directory "/var/cache/bind";

    listen-on { any; };
    listen-on-v6 { none; };

    allow-query { lan; };
    recursion yes;
    allow-recursion { lan; };

    // nomes de fora vão para estes servidores
    forwarders { 8.8.8.8; 1.1.1.1; };

    dnssec-validation auto;
};
